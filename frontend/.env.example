# App runtime — copy to `.env` (loaded by Next.js).
# Client-safe values only via NEXT_PUBLIC_*. Never put secrets here.
# E2E / Playwright / recording → `.env.e2e.example` → `.env.e2e`.

# Backend API (Axios, RSC pages, admin data provider)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional
NEXT_TELEMETRY_DISABLED=1

# Docker bind-mount hot reload (compose frontend profile)
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
WATCHPACK_POLLING=true
WATCHPACK_POLLING_INTERVAL=1000
